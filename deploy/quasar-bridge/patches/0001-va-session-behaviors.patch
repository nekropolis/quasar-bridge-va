+
+func TestVAEllipsisNativeWindow(t *testing.T) {
+	r := &vaSkipRecorder{got: make(chan []string, 10)}
+	n, _, _ := vaChans(t, r)
+	ef := DefaultEllipsisFollowup()
+	n.Ellipsis = &ef
+	ask := func(id, text string) []string {
+		t.Helper()
+		_ = n.Client(t.Context(), websocket.MessageBinary, vaVoice(id))
+		_ = n.Server(t.Context(), websocket.MessageBinary, vaASR(id, text))
+		select {
+		case s := <-r.got:
+			return s
+		case <-time.After(2 * time.Second):
+			t.Fatal("no decision")
+		}
+		return nil
+	}
+	if s := ask("e1", "а музыку"); s != nil {
+		t.Fatalf("no answer yet: %v", s)
+	}
+	_ = n.Client(t.Context(), websocket.MessageBinary, vaStatEnded("e1"))
+	if s := ask("e2", "А музыку"); !slices.Equal(s, []string{"yandex_services"}) {
+		t.Fatalf("in the window: %v", s)
+	}
+	if s := ask("e3", "а включи музыку"); s != nil {
+		t.Fatalf("explicit command: %v", s)
+	}
+	n.mu.Lock()
+	n.lastAnswer = time.Now().Add(-20 * time.Second)
+	n.mu.Unlock()
+	if s := ask("e4", "а музыку"); s != nil {
+		t.Fatalf("window expired: %v", s)
+	}
+	n.Ellipsis = nil
+	_ = n.Client(t.Context(), websocket.MessageBinary, vaStatEnded("e4"))
+	if s := ask("e5", "а музыку"); s != nil {
+		t.Fatalf("feature off: %v", s)
+	}
+}
diff --git a/internal/bridge/va_filler.go b/internal/bridge/va_filler.go
new file mode 100644
index 0000000..d19be8e
--- /dev/null
+++ b/internal/bridge/va_filler.go
@@ -0,0 +1,78 @@
+package bridge
+
+import (
+	"strings"
+	"unicode"
+)
+
+// FollowupFilter drops short acknowledgements and background fragments heard in
+// the window after a local reply. A nil filter or Enabled false keeps them.
+type FollowupFilter struct {
+	Enabled       bool     `json:"enabled"`
+	Fillers       []string `json:"fillers"`
+	Keep          []string `json:"keep"`
+	ShortMaxWords int      `json:"short_max_words"`
+}
+
+func DefaultFollowupFilter() FollowupFilter {
+	return FollowupFilter{Enabled: true, ShortMaxWords: 2,
+		Fillers: strings.Fields("понятно ага ясно спасибо ладно хорошо окей угу ну да-да ага-ага угу-угу ясненько понял поняла принято отлично супер класс круто ок-ок спасибочки благодарю мерси"),
+		Keep: strings.Fields("алиса да нет не неа давай давайте ок конечно ага-да верно точно отмена стоп хватит громче тише еще ещё дальше повтори снова опять " +
+			"а и что как где когда сколько какой какая какое какие почему зачем кто чей ли куда откуда в во на про для с со у о об по до от из за под над при"),
+	}
+}
+
+func vaWords(s string) []string {
+	s = strings.ReplaceAll(strings.ToLower(s), "ё", "е")
+	return strings.FieldsFunc(s, func(r rune) bool { return !(unicode.IsLetter(r) || unicode.IsDigit(r) || r == '-') })
+}
+
+func (f *FollowupFilter) set(xs []string) map[string]bool {
+	m := map[string]bool{}
+	for _, x := range xs {
+		m[strings.Join(vaWords(x), " ")] = true
+	}
+	return m
+}
+
+// IsFiller reports whether a follow-up utterance should be ignored silently.
+func (f *FollowupFilter) IsFiller(text string) bool {
+	if f == nil || !f.Enabled || strings.Contains(text, "?") {
+		return false
+	}
+	words := vaWords(text)
+	if len(words) == 0 {
+		return false
+	}
+	keep, fill := f.set(f.Keep), f.set(f.Fillers)
+	for _, word := range words {
+		if keep[word] {
+			return false
+		}
+	}
+	if fill[strings.Join(words, " ")] {
+		return true
+	}
+	allFill := true
+	for _, word := range words {
+		if !fill[word] {
+			allFill = false
+		}
+	}
+	if allFill {
+		return true
+	}
+	if len(words) > f.ShortMaxWords {
+		return false
+	}
+	for _, word := range words {
+		runes := []rune(word)
+		if unicode.IsDigit(runes[0]) {
+			return false
+		}
+		if len(runes) > 3 && (strings.HasSuffix(word, "и") || strings.HasSuffix(word, "й") || strings.HasSuffix(word, "ь") || strings.HasSuffix(word, "те")) {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/bridge/va_filler_test.go b/internal/bridge/va_filler_test.go
new file mode 100644
index 0000000..8b84b5f
--- /dev/null
+++ b/internal/bridge/va_filler_test.go
@@ -0,0 +1,74 @@
+package bridge
+
+import (
+	"testing"
+	"time"
+
+	"github.com/coder/websocket"
+)
+
+func TestVAFillerClassifier(t *testing.T) {
+	f := DefaultFollowupFilter()
+	for _, s := range []string{"понятно", "Понятно.", "ага", "спасибо", "ну ладно", "да-да", "угу", "окей", "хорошо", "ясно спасибо", "мама пришла", "интересная штука"} {
+		if !f.IsFiller(s) {
+			t.Errorf("must be filler: %q", s)
+		}
+	}
+	for _, s := range []string{"а завтра", "а в детской", "громче", "выключи свет", "да", "нет", "давай", "ок", "Алиса понятно",
+		"сколько градусов", "что?", "включи", "в зале", "почему", "поставь таймер на 5 минут", "расскажи подробнее про погоду завтра", "10"} {
+		if f.IsFiller(s) {
+			t.Errorf("must pass: %q", s)
+		}
+	}
+	off := DefaultFollowupFilter()
+	off.Enabled = false
+	if off.IsFiller("понятно") {
+		t.Error("disabled filter must pass everything")
+	}
+	var nilF *FollowupFilter
+	if nilF.IsFiller("понятно") {
+		t.Error("nil filter must pass")
+	}
+}
+
+func vaRunFollowUp(t *testing.T, asked bool, text string) (silent bool, calls int) {
+	n, up, down := vaSession(t, &calls)
+	f := DefaultFollowupFilter()
+	n.Filler = &f
+	n.listenArmed = time.Now()
+	n.lastAsked = asked
+	_ = n.Client(t.Context(), websocket.MessageBinary, vaVoice("ff"))
+	<-up
+	_ = n.Server(t.Context(), websocket.MessageBinary, vaASR("ff", text))
+	<-down
+	deadline := time.After(2 * time.Second)
+	for {
+		select {
+		case <-up:
+		case fr := <-down:
+			if r := fr.Server.GetEvent().GetAliceResponse(); r != nil {
+				return !r.GetVoiceResponse().GetHasVoiceResponse(), calls
+			}
+		case <-deadline:
+			t.Fatal("no response")
+		}
+	}
+}
+
+func TestVAFillerFollowUpSilent(t *testing.T) {
+	if silent, calls := vaRunFollowUp(t, false, "понятно"); !silent || calls != 0 {
+		t.Fatalf("filler must close silently: silent=%v calls=%d", silent, calls)
+	}
+}
+
+func TestVAFillerAfterOurQuestionPasses(t *testing.T) {
+	if silent, calls := vaRunFollowUp(t, true, "хорошо"); silent || calls != 1 {
+		t.Fatalf("after our question reply must pass: silent=%v calls=%d", silent, calls)
+	}
+}
+
+func TestVAQuestionFollowUpPasses(t *testing.T) {
+	if silent, calls := vaRunFollowUp(t, false, "а завтра"); silent || calls != 1 {
+		t.Fatalf("question must pass: silent=%v calls=%d", silent, calls)
+	}
+}
diff --git a/internal/bridge/va_silent_followup_test.go b/internal/bridge/va_silent_followup_test.go
