+	now := time.Now()
+	if !c.InWindow(now.Add(-14*time.Second), now) || c.InWindow(now.Add(-16*time.Second), now) || c.InWindow(time.Time{}, now) || c.InWindow(now.Add(time.Second), now) {
+		t.Fatal("window")
+	}
+}
